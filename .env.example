# ReadCraft server environment variables.
# Copy to `.env` locally. Never commit real secrets; secrets are configured
# only on the hosting provider in production.

# Port the API listens on.
PORT=8787

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5173

# Optional GitHub token (classic or fine-grained, read-only public scope).
# Raises the unauthenticated rate limit from 60/hr to 5000/hr.
# The token is used ONLY server-side and is never sent to the browser.
GITHUB_TOKEN=

# Cache time-to-live for upstream GitHub responses, in seconds.
CACHE_TTL_SECONDS=300

# --- Hardening knobs (all optional; sane defaults applied when unset) ---

# Rate limiting, per client IP.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=60

# Maximum accepted request body size, in bytes (this API only needs GET).
BODY_LIMIT_BYTES=16384

# Per-request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=15
