# ReadCraft client environment variables.
# Copy this file to `.env.local` and fill in values. Never commit real secrets.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Base URL of the ReadCraft API (the read-only GitHub data proxy).
# Leave empty to use same-origin "/api" (proxied to the server in dev via
# vite.config.ts, served by the deployment in production). Set this only when
# the API runs on a different origin, e.g. https://api.readcraft.example.
VITE_API_BASE_URL=
